{
  "name": "curso-energia-ypfb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run slides && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker --noEmit",
    "data": "python scripts/build_data.py",
    "slides": "node tools/slides-assets.mjs && marp -I slides -o public/slides",
    "slides:preview": "node tools/slides-assets.mjs && marp -I slides -o public/slides -w -p",
    "slides:serve": "marp -s slides",
    "slides:pdf": "marp --allow-local-files --pdf --pdf-notes --pdf-outlines -I slides -o public/handouts",
    "slides:notes": "marp --notes -I slides -o build/notas",
    "slides:fonts": "node tools/marp-fonts.mjs",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.0",
    "@mdx-js/rollup": "^3.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^2.1.9"
  }
}
