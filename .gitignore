node_modules/
dist/
*.local
.DS_Store

# Bytecode de Python (no versionar)
__pycache__/
*.pyc

# Datos crudos bajados por los scripts de precómputo (se regeneran, no se versionan)
scripts/_cache/

# Decks Marp generados: los produce npm run build desde slides/*.md.
# Los PDF de public/handouts/ SÍ se versionan (generarlos necesita navegador).
public/slides/
build/

# Worker: secretos locales y estado de wrangler
worker/.dev.vars
worker/.wrangler/
worker/node_modules/

# Dump de D1 (npm run export en worker/): trae respuestas con nombres, no se versiona
worker/backup.sql
